{
  "name": "case-tecnico-integracao-chatbot",
  "version": "1.0.0",
  "description": "Integração Suri (Chatbot Maker) x serviço próprio para envio de 2ª via de boleto via WhatsApp, com validação de CPF. Resposta ao contato enviada ativamente pela API da Suri.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint \"*.js\" \"src/**/*.js\" \"tests/**/*.js\"",
    "lint:fix": "eslint \"*.js\" \"src/**/*.js\" \"tests/**/*.js\" --fix",
    "format": "prettier --write \"*.js\" \"src/**/*.js\" \"tests/**/*.js\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand"
  },
  "keywords": ["suri", "chatbot-maker", "whatsapp", "api", "cpf", "boleto", "express"],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "supertest": "^7.0.0"
  }
}